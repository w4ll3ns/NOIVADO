# ─────────────────────────────────────────────────────────────
#  Noivado Maby & Chris — variáveis de ambiente
#  Copie para .env e preencha. NUNCA versione o .env.
# ─────────────────────────────────────────────────────────────

# Banco PostgreSQL
DATABASE_URL=postgres://noivado:noivado@localhost:5432/noivado
# DATABASE_POOL_SIZE=10
# Use "false" com poolers em modo transação (ex.: PgBouncer, Supabase pooler)
# DATABASE_PREPARE=false

# Endereço público do site (sem barra no final). Usado nos links dos convites e QR Codes.
APP_URL=https://www.seudominio.com.br

# Segredo com 32+ caracteres (gere com: openssl rand -base64 48)
APP_SECRET=

# Chave estável para Server Actions quando houver mais de uma instância (openssl rand -base64 32)
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Atrás de proxy reverso/CDN, confia em X-Forwarded-For para limitar abusos por IP
TRUST_PROXY=true
# Redireciona http → https e ativa upgrade-insecure-requests (produção). Use "false" só para testes locais.
# FORCE_HTTPS=true

# ── Mercado Pago (Checkout Pro) ──────────────────────────────
# Credenciais em https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=
# Assinatura secreta dos Webhooks (Suas integrações → Webhooks)
MP_WEBHOOK_SECRET=
# true para usar sandbox_init_point com credenciais de teste antigas
# MP_USE_SANDBOX=false

# Somente desenvolvimento: simula o pagamento quando não há MP_ACCESS_TOKEN
# (ignorado em produção)
PAYMENTS_SIMULATION=true

# ── Armazenamento de fotos ───────────────────────────────────
# local (disco/volume) ou s3 (AWS S3, Cloudflare R2, Backblaze B2, MinIO…)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# Tamanho máximo por foto (MB)
MAX_UPLOAD_MB=25

# ── Primeiro acesso ao painel (usado por npm run db:seed) ────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Maby & Chris

# ── docker-compose (VPS) ─────────────────────────────────────
# Domínio para o HTTPS automático do Caddy
DOMAIN=www.seudominio.com.br
POSTGRES_PASSWORD=troque-esta-senha
